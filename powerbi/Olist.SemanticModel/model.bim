        "measures": [
          {
            "name": "Cohort Customers",
            "expression": "SUMX(VALUES(Cohort[cohort_month]), CALCULATE(MAX(Cohort[cohort_size])))",
            "formatString": "#,0",
            "lineageTag": "70bba090-011e-5642-8a47-c5c6ae2c903a"
          },
          {
            "name": "Cohort Activity Rate",
            "expression": "IF(HASONEVALUE(Cohort[month_index]), DIVIDE(CALCULATE(SUM(Cohort[active_customers]), Cohort[is_observable] = TRUE()), CALCULATE([Cohort Customers], Cohort[is_observable] = TRUE())))",
            "formatString": "0.00%",
            "lineageTag": "89003dec-46b1-5418-b8af-a9ba44c9cc5d"
          },
          {
            "name": "Later Month Activity Rate",
            "expression": "IF(SELECTEDVALUE(Cohort[month_index], -1) > 0, [Cohort Activity Rate])",
            "formatString": "0.00%",
            "lineageTag": "b5639da0-227e-5fb2-a4c9-ad27250c6b17"
          }
        ]
