        ],
        "measures": [
          {
            "name": "Orders in Activity Period",
            "expression": "COUNTROWS(Orders)",
            "formatString": "#,0",
            "lineageTag": "95c9a026-890f-58fd-ac41-f4406533e9de"
          },
          {
            "name": "Returning Orders",
            "expression": "CALCULATE([Orders in Activity Period], KEEPFILTERS(Orders[is_returning_order] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "5bbbac45-0759-5947-bb1c-8b5d406d6463"
          },
          {
            "name": "Activity Merchandise Value",
            "expression": "SUM(Orders[merchandise_value])",
