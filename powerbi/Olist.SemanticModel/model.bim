        "partitions": [
          {
            "name": "Customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5432\", \"olist_customer_analytics\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"bi\",Item=\"customers\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Customers",
            "expression": "COUNTROWS(Customers)",
            "formatString": "#,0",
            "lineageTag": "99d10e15-9ec2-5e80-9a22-48c13f0a5d13"
          },
          {
            "name": "Snapshot Orders",
            "expression": "SUM(Customers[order_count])",
            "formatString": "#,0",
            "lineageTag": "dec75506-af55-5ecc-a2da-3f2c760fc1ba"
          },
          {
            "name": "Observed Merchandise Value",
            "expression": "SUM(Customers[monetary_value])",
            "formatString": "\"BRL \" #,0.00",
            "lineageTag": "1f9091d7-1500-5fd0-b5d9-f6cfdbde5621"
          },
          {
            "name": "Repeat Customers",
            "expression": "CALCULATE([Customers], KEEPFILTERS(Customers[is_repeat_customer] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "29726d15-eaa3-5370-9894-c956603882c0"
          },
          {
            "name": "Observed Repeat Rate",
            "expression": "DIVIDE([Repeat Customers], [Customers])",
            "formatString": "0.00%",
            "lineageTag": "c1818f20-9b6e-5cb7-a900-4cad3bf4dca1"
          },
          {
            "name": "Purchases per Customer",
            "expression": "DIVIDE([Snapshot Orders], [Customers])",
            "formatString": "0.00",
            "lineageTag": "af8a8846-1d14-5680-b9c7-23a173984746"
          },
          {
            "name": "Average Recency Days",
            "expression": "AVERAGE(Customers[recency_days])",
            "formatString": "0.0",
            "lineageTag": "e2659de6-9ad8-52c4-bb2e-96eb272106ed"
          },
          {
            "name": "Average Frequency",
            "expression": "AVERAGE(Customers[order_count])",
            "formatString": "0.00",
            "lineageTag": "e68488c3-ae72-50ac-a084-78984ea93bd8"
          },
          {
            "name": "Median Customer Value",
            "expression": "MEDIAN(Customers[monetary_value])",
            "formatString": "\"BRL \" #,0.00",
            "lineageTag": "577f40fc-43a1-51b8-95e0-0e988d0f346b"
          },
          {
            "name": "Customer Share",
            "expression": "DIVIDE([Customers], CALCULATE([Customers], REMOVEFILTERS(Customers[segment])))",
            "formatString": "0.00%",
            "lineageTag": "0659f98e-11d0-5d9d-b3bb-0ceba7c1390a"
          }
        ]
      },
