            "summarizeBy": "none",
            "lineageTag": "95d5e17b-91f6-5ba3-a197-9657e4bf2598"
          },
          {
            "name": "window_days",
            "dataType": "int64",
            "sourceColumn": "window_days",
            "summarizeBy": "none",
            "lineageTag": "d3bf46c9-6379-5410-aeea-848042cb57e0"
          },
          {
            "name": "is_eligible",
            "dataType": "boolean",
            "sourceColumn": "is_eligible",
            "summarizeBy": "none",
            "lineageTag": "5587a7f3-a7cf-5710-9aaa-7eb380feb9ac"
          },
          {
            "name": "repeated_within_window",
            "dataType": "boolean",
            "sourceColumn": "repeated_within_window",
            "summarizeBy": "none",
            "lineageTag": "3fca5f11-658e-5070-859b-1f28b09edd95"
          },
          {
            "name": "common_90_day_population",
            "dataType": "boolean",
            "sourceColumn": "common_90_day_population",
            "summarizeBy": "none",
            "lineageTag": "b91c775a-6fd8-593b-976d-e1a85775ed70"
          }
        ],
        "partitions": [
          {
            "name": "RepeatWindows",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5432\", \"olist_customer_analytics\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"bi\",Item=\"repeat_windows\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Eligible Customers",
            "expression": "IF(HASONEVALUE(RepeatWindows[window_days]), CALCULATE(COUNTROWS(RepeatWindows), RepeatWindows[is_eligible] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "9c58f30c-2b4b-5045-ab59-0d786f04ae76"
          },
          {
            "name": "Window Repeat Customers",
            "expression": "IF(HASONEVALUE(RepeatWindows[window_days]), CALCULATE(COUNTROWS(RepeatWindows), RepeatWindows[repeated_within_window] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "f20c7211-ee54-5872-a6f2-0c5ca4047192"
          },
          {
            "name": "Window Repeat Rate",
            "expression": "DIVIDE([Window Repeat Customers], [Eligible Customers])",
            "formatString": "0.00%",
            "lineageTag": "6d260a9c-a3da-5aec-8ec2-9b97deef186a"
          },
          {
            "name": "Common Eligible Customers",
            "expression": "IF(HASONEVALUE(RepeatWindows[window_days]), CALCULATE(COUNTROWS(RepeatWindows), RepeatWindows[common_90_day_population] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "45c18343-2f99-5382-95c8-d7a186a97afe"
          },
          {
            "name": "Common Window Repeat Customers",
            "expression": "IF(HASONEVALUE(RepeatWindows[window_days]), CALCULATE(COUNTROWS(RepeatWindows), RepeatWindows[common_90_day_population] = TRUE(), RepeatWindows[repeated_within_window] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "51a4e024-7e2d-502b-bbae-da46b757ff87"
          },
          {
            "name": "Common Window Repeat Rate",
            "expression": "DIVIDE([Common Window Repeat Customers], [Common Eligible Customers])",
            "formatString": "0.00%",
            "lineageTag": "3e165f0c-de3e-5120-bd03-43f46bca1741"
          },
          {
            "name": "90 Day Repeat Rate",
            "expression": "CALCULATE([Window Repeat Rate], RepeatWindows[window_days] = 90)",
            "formatString": "0.00%",
